# ---------------------------------------------------------------------------
# Texto: ideias de história, perguntas da entrevista e roteiro página a página
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Imagens: Google (Gemini) — o provider preferido
#
# Mesma família de modelos que a Higgsfield revende como "Nano Banana", só que
# de primeira mão. Crie a chave em https://aistudio.google.com/apikey
#
# Sem nenhuma credencial de imagem o app usa o provider "mock": o fluxo inteiro
# funciona, mas o PDF sai com molduras de prévia no lugar das ilustrações.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Só se quiser fugir dos padrões do código.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_ASPECT_RATIO=3:4
# GEMINI_IMAGE_SIZE=2K

# Força o provider de imagem: "mock" (o padrão é google, quando há chave).
# IMAGE_PROVIDER=mock

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Pagamento: Mercado Pago, Pix
#
# Pega os dois em https://www.mercadopago.com.br/developers/panel — a
# aplicação, depois "Credenciais de teste" (ou produção, quando for a hora).
# O webhook secret é o mesmo painel, aba Webhooks > Configurar notificação.
#
# Sem essas duas, o botão "Pagar com Pix" aparece e falha com um erro claro
# na tela — nada quebra, só não é possível pagar de verdade.
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Endereço da própria aplicação.
#
# Usado só internamente: o servidor busca os próprios arquivos guardados (as
# fichas de personagem, as páginas prontas para montar o PDF). Nada de fora
# precisa alcançá-los. Em produção defina isso — na Vercel, VERCEL_URL já é
# usado automaticamente.
# ---------------------------------------------------------------------------
# APP_URL=https://seudominio.com
