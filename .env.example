# ---------------------------------------------------------------------------
# Texto: ideias de história, perguntas da entrevista e roteiro página a página
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Imagens: Higgsfield
#
# Sem estas variáveis o app usa o provider "mock": o fluxo inteiro funciona,
# mas o PDF sai com molduras de prévia no lugar das ilustrações.
# ---------------------------------------------------------------------------
# Formato "KEY_ID:KEY_SECRET"
HIGGSFIELD_CREDENTIALS=

# O endpoint do modelo de imagem. Confira em docs.higgsfield.ai qual endpoint
# corresponde ao modelo que você quer usar. Recomendado: um modelo que aceite
# imagens de referência, para manter o personagem consistente entre as páginas.
HIGGSFIELD_IMAGE_ENDPOINT=

# Opcionais — só mexa se o endpoint escolhido esperar outro formato.
# 3:4 é o que melhor encaixa em A4 com margem.
# HIGGSFIELD_ASPECT_RATIO=3:4
# HIGGSFIELD_REFERENCE_FIELD=input_images

# Força o provider de imagem: "mock" ou "higgsfield".
# IMAGE_PROVIDER=mock

# ---------------------------------------------------------------------------
# URL pública da aplicação.
#
# O Higgsfield busca as imagens de referência pela rede, então precisa de uma
# URL que ele consiga alcançar. Em produção defina isso (na Vercel, VERCEL_URL
# já é usado automaticamente).
# ---------------------------------------------------------------------------
# APP_URL=https://seudominio.com
